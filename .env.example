# Vorlage fuer .env. Kopieren, dann Werte eintragen:
#   cp .env.example .env
#
# .env ist gitignoriert und darf nicht eingecheckt werden.
#
# Werte hier bleiben LEER. Diese Datei liegt im oeffentlichen Repo.
#
# .env wird von pydantic-settings gelesen und NICHT in die Shell gesourct.
# Ein in die Umgebung exportierter API-Schluessel hat Vorrang vor anderen
# Anmeldewegen und veraendert damit still, worueber abgerechnet wird.

# --- Anwendung -------------------------------------------------------------
APP_ENV=
LOG_LEVEL=

# --- LLM-Provider ----------------------------------------------------------
# openai | azure | anthropic
# Die Factory in app/llm.py liefert fuer alle drei dieselbe Schnittstelle.
# Ausserhalb dieses Moduls wird nicht nach Provider verzweigt.
LLM_PROVIDER=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=

# Azure OpenAI
# Die Modellverfuegbarkeit ist regionsabhaengig, deshalb ist die Region ein
# eigener Parameter und nicht Teil des Endpunkts.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_REGION=
AZURE_OPENAI_API_VERSION=
AZURE_OPENAI_DEPLOYMENT=

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# --- Embeddings ------------------------------------------------------------
# multilingual-e5 verlangt die Praefixe "query: " und "passage: " auf jedem
# Input, auch bei deutschem Text. Sie werden im Embedding-Wrapper gesetzt und
# stehen nicht im gespeicherten Chunk-Text.
EMBEDDING_MODEL=
EMBEDDING_DEVICE=
EMBEDDING_BATCH_SIZE=

# --- Retrieval -------------------------------------------------------------
# Wert zwischen 0 und 1, groesser ist besser. Unterschreitet der beste Score
# diesen Wert, wird eskaliert statt generiert - es wird nie ohne belastbaren
# Kontext geantwortet.
#
# Der Wert ist modellspezifisch und muss gegen den Eval-Datensatz kalibriert
# werden. Ein von einem anderen Modell uebernommener Wert ist falsch.
RETRIEVAL_SCORE_THRESHOLD=
RETRIEVAL_TOP_K=
CHUNK_SIZE=
CHUNK_OVERLAP=

# --- Pfade -----------------------------------------------------------------
# Das Dateisystem gilt als fluechtig. Der Index wird pro Bereitstellung neu
# gebaut und ueberlebt einen Neustart nicht.
TENANTS_DIR=
INDEX_DIR=

# --- Deployment ------------------------------------------------------------
# Nur die eigene Sandbox-Subscription. Schreibende Kommandos fuehren die
# Subscription immer explizit mit.
#
# Container-Images liegen in der GitHub Container Registry und werden ohne
# Anmeldung gezogen.
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
AZURE_LOCATION=
AZURE_CONTAINERAPPS_ENVIRONMENT=
GHCR_IMAGE=

# --- Telemetrie ------------------------------------------------------------
# Jedes Event traegt tenant_id als Dimension. Dokumentinhalte, Nutzerfragen und
# Modellantworten gehoeren NICHT ins Log.
#
# Zwei Ebenen, die nicht zu verwechseln sind:
#   Instrumentierung = OpenTelemetry. Spans und Metriken ueber tracer und meter.
#   Ziel             = Application Insights, eingebunden ueber die Azure Monitor
#                      OpenTelemetry Distro (azure-monitor-opentelemetry).
#
# configure_azure_monitor() liest den Connection String aus der Variable unten.
# Fehlt sie, gibt es keinen Azure-Export.
TELEMETRY_ENABLED=
APPLICATIONINSIGHTS_CONNECTION_STRING=

# Zusaetzlicher Ausgabeweg fuer den Fall, dass die Anwendung ausserhalb von Azure
# laeuft. Steht NEBEN dem Azure-Pfad, nicht an seiner Stelle.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Eskalation ------------------------------------------------------------
# degenerate_only | absolute_threshold | relative_margin
#
# Voreinstellung ist degenerate_only: eskaliert nur bei leerer Trefferliste.
# Das ist KEIN Schwellwert und soll keiner sein. Bis Phase 5 traegt das
# Groundedness-Tor die Last allein (ADR-018).
ESCALATION_STRATEGY=

# Nur fuer relative_margin. Mindestabstand zwischen bestem Treffer und dem
# Median der Trefferliste. Bewusst ohne Default, wie der Schwellwert.
ESCALATION_MIN_MARGIN=
